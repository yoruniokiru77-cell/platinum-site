# Apply supabase/migrations/20261005_public_shifts.sql first.
SHIFT_PUBLIC_API_URL=https://rzfprialypdoyklfwpyg.supabase.co/rest/v1/rpc/platinum_public_shifts
# Supabase public anon JWT key only. A service-role key is unnecessary.
SHIFT_PUBLIC_API_KEY=
# Confirmed: Oct 5 01:00 is Oct 4 25:00 (previous business day).
SHIFT_DATE_BASIS=calendar
HOST=127.0.0.1
PORT=4173
# Vercel server-side environment only. Never put either value in assets/config.js.
SUPABASE_SERVICE_ROLE_KEY=
# A random secret of at least 32 characters; Vercel Cron sends it as a Bearer token.
CRON_SECRET=
# Set to the verified custom domain in Vercel, then redeploy (HTTPS origin only).
SITE_URL=https://platinum-site-theta.vercel.app
